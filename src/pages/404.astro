---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página não encontrada" noindex>
  <div class="mx-auto flex max-w-xl flex-col items-center gap-3 px-4 py-24 text-center sm:px-6">
    <span class="text-sm font-semibold uppercase tracking-wide text-brand-400">Erro 404</span>
    <h1 class="font-display text-4xl font-extrabold uppercase tracking-tight text-white">Página não encontrada</h1>
    <p class="text-ink-400">O link que você acessou não existe ou foi removido do catálogo.</p>
    <a
      href="/"
      class="mt-4 inline-flex min-h-11 items-center justify-center rounded-full bg-brand-500 px-6 text-sm font-semibold text-surface-0 transition-colors hover:bg-brand-400"
    >
      Voltar para a página inicial
    </a>
  </div>
</BaseLayout>
