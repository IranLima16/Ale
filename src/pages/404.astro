---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página não encontrada" noindex>
  <div class="mx-auto flex max-w-xl flex-col items-center gap-3 px-4 py-24 text-center sm:px-6">
    <span class="text-sm font-semibold uppercase tracking-wide text-brand-600">Erro 404</span>
    <h1 class="text-3xl font-extrabold text-ink-900">Página não encontrada</h1>
    <p class="text-ink-500">O link que você acessou não existe ou foi removido do catálogo.</p>
    <a
      href="/"
      class="mt-4 inline-flex items-center justify-center rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
    >
      Voltar para a página inicial
    </a>
  </div>
</BaseLayout>
