---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchResults from "../components/SearchResults";
import { getSearchIndex } from "../lib/catalog";

const index = getSearchIndex();
---

<BaseLayout title="Busca" description="Busque camisas por time, país, temporada ou categoria." noindex>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <h1 class="font-display text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Buscar no catálogo</h1>
    <p class="mt-1 text-ink-400">Busque por país, time, nome da camisa, temporada ou categoria.</p>

    <div class="mt-6">
      <SearchResults client:load index={index} />
    </div>
  </div>
</BaseLayout>
