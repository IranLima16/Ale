---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchResults from "../components/SearchResults";
import { getSearchIndex } from "../lib/catalog";

const index = getSearchIndex();
---

<BaseLayout title="Busca" description="Busque camisas por time, país, temporada ou categoria." noindex>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <h1 class="text-2xl font-extrabold text-ink-900 sm:text-3xl">Buscar no catálogo</h1>
    <p class="mt-1 text-ink-500">Busque por país, time, nome da camisa, temporada ou categoria.</p>

    <div class="mt-6">
      <SearchResults client:load index={index} />
    </div>
  </div>
</BaseLayout>
