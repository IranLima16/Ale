---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ImageGallery from "../../../components/ImageGallery";
import WhatsAppButton from "../../../components/WhatsAppButton.astro";
import {
  getAllProducts,
  getTeamById,
  getCountryById,
  getCategoryById,
  getCountryPath,
  getTeamPath,
} from "../../../lib/catalog";
import { formatPrice } from "../../../lib/format";
import { getProductWhatsAppLink } from "../../../lib/whatsapp";

export function getStaticPaths() {
  return getAllProducts()
    .map((product) => {
      const team = getTeamById(product.teamId);
      const country = getCountryById(product.countryId);
      if (!team || !country) return null;
      return {
        params: { country: country.slug, team: team.slug, product: product.slug },
        props: { product, team, country },
      };
    })
    .filter((entry): entry is NonNullable<typeof entry> => entry !== null);
}

const { product, team, country } = Astro.props;
const category = getCategoryById(product.categoryId);
const images = [product.mainImage, ...(product.additionalImages ?? [])];
const hasPromo = typeof product.promoPrice === "number";
const discountPct = hasPromo ? Math.round((1 - product.promoPrice! / product.price) * 100) : 0;
const whatsappHref = getProductWhatsAppLink(product, team);
---

<BaseLayout
  title={`${product.name} · ${team.name}`}
  description={product.shortDescription}
  image={product.mainImage}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <Breadcrumbs
      items={[
        { label: country.name, href: getCountryPath(country) },
        { label: team.name, href: getTeamPath(team) },
        { label: product.name },
      ]}
    />

    <div class="grid gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
      <div class="relative">
        {
          hasPromo ? (
            <span class="absolute left-6 top-6 z-10 rounded-full bg-brand-500 px-3 py-1.5 text-xs font-bold text-surface-0 shadow-lg shadow-black/40">
              -{discountPct}% OFF
            </span>
          ) : (
            product.featured && (
              <span class="absolute left-6 top-6 z-10 rounded-full bg-gold-400 px-3 py-1.5 text-xs font-bold text-surface-0 shadow-lg shadow-black/40">
                Destaque
              </span>
            )
          )
        }
        <ImageGallery client:visible images={images} productName={product.name} />
      </div>

      <div class="flex flex-col gap-6 lg:sticky lg:top-24 lg:self-start">
        <div>
          <a
            href={getTeamPath(team)}
            class="inline-flex items-center gap-2 text-sm font-semibold text-brand-400 hover:underline"
          >
            <span class="flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden rounded-full bg-surface-2 ring-1 ring-inset ring-white/10">
              <img src={team.logo} alt="" width={28} height={28} class="h-full w-full object-cover" />
            </span>
            {team.name}
          </a>
          <h1 class="mt-2 font-display text-3xl font-extrabold uppercase leading-tight tracking-tight text-white sm:text-4xl">
            {product.name}
          </h1>
        </div>

        <dl class="grid grid-cols-2 gap-3 rounded-2xl border border-white/8 bg-surface-1/60 p-4">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-ink-500">Temporada</dt>
            <dd class="mt-0.5 font-semibold text-white">{product.season}</dd>
          </div>
          {category && (
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-ink-500">Categoria</dt>
              <dd class="mt-0.5 font-semibold text-gold-300">{category.name}</dd>
            </div>
          )}
        </dl>

        <p class="leading-relaxed text-ink-300">{product.shortDescription}</p>

        <div class="stadium-texture relative overflow-hidden rounded-2xl border border-white/10 bg-surface-1 p-5 shadow-xl shadow-black/30 sm:p-6">
          <div class="flex items-baseline gap-3 font-display">
            {
              hasPromo ? (
                <>
                  <span class="text-4xl font-extrabold text-brand-400 sm:text-5xl">{formatPrice(product.promoPrice!)}</span>
                  <span class="text-lg text-ink-500 line-through">{formatPrice(product.price)}</span>
                </>
              ) : (
                <span class="text-4xl font-extrabold text-white sm:text-5xl">{formatPrice(product.price)}</span>
              )
            }
          </div>
          <p class="mt-1 text-xs text-ink-500">à combinar no WhatsApp · pagamento direto com o vendedor</p>

          <div class="mt-4">
            <WhatsAppButton
              href={whatsappHref}
              label="Tenho interesse, falar no WhatsApp"
              size="lg"
              attention
              class="w-full"
            />
          </div>
          <p class="mt-3 text-xs text-ink-500">
            Tamanhos e disponibilidade são confirmados diretamente com o vendedor pelo WhatsApp.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
