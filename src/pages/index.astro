---
import BaseLayout from "../layouts/BaseLayout.astro";
import CountryCard from "../components/CountryCard";
import TeamCard from "../components/TeamCard";
import ProductCard from "../components/ProductCard";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { siteConfig } from "../config/site";
import {
  getActiveCountries,
  getFeaturedProducts,
  getFeaturedTeams,
  getTeamsByCountryId,
  getTeamById,
  getTeamPath,
  getCountryPath,
  getProductPath,
} from "../lib/catalog";
import { getGeneralWhatsAppLink } from "../lib/whatsapp";

const countries = getActiveCountries();
const featuredTeams = getFeaturedTeams();
const featuredProducts = getFeaturedProducts();
const whatsappHref = getGeneralWhatsAppLink();
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rotate-12 bg-gradient-to-br from-brand-500/25 to-transparent sm:h-96 sm:w-96"
      style="clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 70%);"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute bottom-0 left-0 h-1.5 w-full bg-gradient-to-r from-brand-500 via-gold-400 to-brand-500"
    >
    </div>
    <div class="relative mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 sm:px-6 sm:py-20">
      <div class="max-w-2xl animate-fade-up">
        <span class="inline-flex items-center gap-2 rounded-full bg-gold-400/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-gold-300">
          Catálogo digital
        </span>
        <h1 class="mt-4 font-display text-4xl font-extrabold uppercase leading-none tracking-tight sm:text-6xl">
          {siteConfig.name}
        </h1>
        <p class="mt-3 text-base text-ink-300 sm:text-lg">{siteConfig.tagline}</p>
      </div>
      <div class="flex flex-wrap gap-3 animate-fade-up" style="animation-delay: 0.1s;">
        <a
          href="#paises"
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-white/20 px-5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          Ver países
        </a>
        <WhatsAppButton href={whatsappHref} label="Falar no WhatsApp" size="lg" />
      </div>
    </div>
  </section>

  <section id="paises" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <h2 class="flex items-center gap-2 font-display text-2xl font-bold uppercase tracking-tight text-ink-900 sm:text-3xl">
      <span class="h-5 w-1.5 shrink-0 rounded-full bg-brand-600"></span>
      Navegue por país
    </h2>
    <p class="mt-1 text-sm text-ink-500">Escolha um país para ver os times disponíveis.</p>
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {
        countries.map((country) => (
          <CountryCard
            country={country}
            href={getCountryPath(country)}
            teamCount={getTeamsByCountryId(country.id).length}
          />
        ))
      }
    </div>
  </section>

  {
    featuredTeams.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <h2 class="flex items-center gap-2 font-display text-2xl font-bold uppercase tracking-tight text-ink-900 sm:text-3xl">
          <span class="h-5 w-1.5 shrink-0 rounded-full bg-gold-500"></span>
          Times em destaque
        </h2>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {featuredTeams.map((team) => {
            const resolvedTeam = getTeamById(team.id);
            return (
              resolvedTeam && (
                <TeamCard team={resolvedTeam} href={getTeamPath(resolvedTeam)} />
              )
            );
          })}
        </div>
      </section>
    )
  }

  {
    featuredProducts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <h2 class="flex items-center gap-2 font-display text-2xl font-bold uppercase tracking-tight text-ink-900 sm:text-3xl">
          <span class="h-5 w-1.5 shrink-0 rounded-full bg-brand-600"></span>
          Camisas em destaque
        </h2>
        <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {featuredProducts.map((product) => (
            <ProductCard
              product={product}
              href={getProductPath(product)}
              teamName={getTeamById(product.teamId)?.name}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="relative overflow-hidden rounded-3xl bg-ink-900 px-6 py-8 text-white">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rotate-12 bg-brand-500/20"
        style="clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 70%);"
      >
      </div>
      <div class="relative flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-display text-2xl font-bold uppercase tracking-tight">Não encontrou a camisa que queria?</h2>
          <p class="mt-1 text-ink-300">Fale direto com a gente pelo WhatsApp e consulte disponibilidade.</p>
        </div>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full bg-brand-500 px-6 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 hover:bg-brand-400"
        >
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
