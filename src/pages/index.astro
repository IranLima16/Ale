---
import BaseLayout from "../layouts/BaseLayout.astro";
import CountryCard from "../components/CountryCard";
import TeamCard from "../components/TeamCard";
import ProductCard from "../components/ProductCard";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { siteConfig } from "../config/site";
import {
  getActiveCountries,
  getFeaturedProducts,
  getFeaturedTeams,
  getTeamsByCountryId,
  getTeamById,
  getTeamPath,
  getCountryPath,
  getProductPath,
} from "../lib/catalog";
import { getGeneralWhatsAppLink } from "../lib/whatsapp";

const countries = getActiveCountries();
const featuredTeams = getFeaturedTeams();
const featuredProducts = getFeaturedProducts();
const whatsappHref = getGeneralWhatsAppLink();
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="bg-ink-900 text-white">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 sm:px-6 sm:py-20">
      <div class="max-w-2xl">
        <span class="inline-block rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-300">
          Catálogo digital
        </span>
        <h1 class="mt-4 text-3xl font-extrabold leading-tight sm:text-5xl">{siteConfig.name}</h1>
        <p class="mt-3 text-base text-ink-300 sm:text-lg">{siteConfig.tagline}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="#paises"
          class="inline-flex items-center justify-center rounded-full border border-white/20 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          Ver países
        </a>
        <WhatsAppButton href={whatsappHref} label="Falar no WhatsApp" size="lg" />
      </div>
    </div>
  </section>

  <section id="paises" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <h2 class="text-xl font-bold text-ink-900 sm:text-2xl">Navegue por país</h2>
    <p class="mt-1 text-sm text-ink-500">Escolha um país para ver os times disponíveis.</p>
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {
        countries.map((country) => (
          <CountryCard
            country={country}
            href={getCountryPath(country)}
            teamCount={getTeamsByCountryId(country.id).length}
          />
        ))
      }
    </div>
  </section>

  {
    featuredTeams.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <h2 class="text-xl font-bold text-ink-900 sm:text-2xl">Times em destaque</h2>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {featuredTeams.map((team) => {
            const resolvedTeam = getTeamById(team.id);
            return (
              resolvedTeam && (
                <TeamCard team={resolvedTeam} href={getTeamPath(resolvedTeam)} />
              )
            );
          })}
        </div>
      </section>
    )
  }

  {
    featuredProducts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <h2 class="text-xl font-bold text-ink-900 sm:text-2xl">Camisas em destaque</h2>
        <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {featuredProducts.map((product) => (
            <ProductCard
              product={product}
              href={getProductPath(product)}
              teamName={getTeamById(product.teamId)?.name}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="flex flex-col items-start gap-4 rounded-3xl bg-brand-600 px-6 py-8 text-white sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-bold">Não encontrou a camisa que queria?</h2>
        <p class="mt-1 text-brand-50">Fale direto com a gente pelo WhatsApp e consulte disponibilidade.</p>
      </div>
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-700 transition-transform hover:-translate-y-0.5"
      >
        Falar no WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>
