---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<div class="rounded-2xl border border-dashed border-ink-300 bg-white p-10 text-center">
  <p class="font-semibold text-ink-900">{title}</p>
  {description && <p class="mt-1 text-sm text-ink-500">{description}</p>}
</div>
