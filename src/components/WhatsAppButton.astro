---
interface Props {
  href: string;
  label: string;
  size?: "md" | "lg";
  variant?: "solid" | "outline";
  /** Destaca o botão com brilho pulsante sutil — use no CTA principal da página de produto. */
  attention?: boolean;
  class?: string;
}

const { href, label, size = "md", variant = "solid", attention = false, class: className = "" } = Astro.props;

const sizeClasses = size === "lg" ? "min-h-14 px-7 text-base" : "min-h-11 px-4 text-sm";
const variantClasses =
  variant === "solid"
    ? "bg-gradient-to-r from-brand-400 to-brand-600 text-surface-0 shadow-lg shadow-brand-500/25 hover:shadow-brand-400/40 hover:from-brand-300 hover:to-brand-500"
    : "border border-brand-400 text-brand-400 hover:bg-brand-400/10";
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "inline-flex items-center justify-center gap-2.5 rounded-full font-bold transition-[transform,box-shadow,background-image] duration-200 hover:-translate-y-0.5 active:translate-y-0",
    sizeClasses,
    variantClasses,
    attention && "motion-safe:animate-pulse-glow",
    className,
  ]}
>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class:list={["shrink-0", size === "lg" ? "h-6 w-6" : "h-5 w-5"]}>
    <path
      d="M12 2C6.48 2 2 6.48 2 12c0 1.87.5 3.63 1.38 5.15L2 22l4.98-1.31A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Zm0 18c-1.63 0-3.15-.44-4.46-1.22l-.32-.19-3.02.79.8-2.95-.2-.31A7.95 7.95 0 0 1 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8Zm4.36-5.96c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
    ></path>
  </svg>
  {label}
</a>
