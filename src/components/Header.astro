---
import { siteConfig } from "../config/site";
import { getSearchIndex } from "../lib/catalog";
import { getGeneralWhatsAppLink } from "../lib/whatsapp";
import SearchBar from "./SearchBar";

const searchIndex = getSearchIndex();
const whatsappHref = getGeneralWhatsAppLink();
---

<header class="sticky top-0 z-30 border-b border-ink-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 sm:px-6">
    <div class="flex items-center justify-between gap-3">
      <a href="/" class="flex shrink-0 items-center gap-2 font-bold text-ink-900">
        {
          siteConfig.logoImage ? (
            <img src={siteConfig.logoImage} alt={siteConfig.name} width="160" height="32" class="h-8 w-auto" />
          ) : (
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-ink-900 text-sm font-extrabold text-white">
              {siteConfig.name
                .split(" ")
                .map((w) => w[0])
                .slice(0, 2)
                .join("")}
            </span>
          )
        }
        <span class="hidden font-display text-lg font-bold uppercase leading-none tracking-wide sm:inline">{siteConfig.name}</span>
      </a>

      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Falar no WhatsApp"
        class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-brand-600 px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 1.87.5 3.63 1.38 5.15L2 22l4.98-1.31A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Zm0 18c-1.63 0-3.15-.44-4.46-1.22l-.32-.19-3.02.79.8-2.95-.2-.31A7.95 7.95 0 0 1 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8Zm4.36-5.96c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
          ></path>
        </svg>
        <span class="hidden sm:inline">Falar no WhatsApp</span>
      </a>
    </div>

    <SearchBar client:idle index={searchIndex} />
  </div>
</header>
